{
    "manifest_version": 3,
    "name": "Dealer Inspire WordPress Admin Login",
    "version": "1.0.0",
    "description": "Opens the WordPress admin page for the current Dealer Inspire website.",
    "permissions": [
        "activeTab"
    ],
    "action": {
        "default_title": "Dealer Inspire WordPress Admin Login",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "background": {
        "service_worker": "background.js"
    }
}